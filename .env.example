# Copy to .env.local and fill in. .env.local is never committed.

# Where the SQLite file lives (default: data/packaging.db inside the app folder).
# Review photos are stored inside this file too, so backing it up covers everything.
# PACKAGING_DB_PATH=./data/packaging.db

# Admin password for anything beyond review answers (flag rules, reference data, settings, deletes).
# No default: leave it empty and every admin action is refused. Never "admin".
ADMIN_PASSWORD=
